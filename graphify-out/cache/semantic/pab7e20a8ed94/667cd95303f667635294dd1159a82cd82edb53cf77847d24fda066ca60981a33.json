{"nodes": [{"id": "openlab_3d_docs_workbench_round4_bench_zoom", "label": "Bench Zoom Screenshot (Workbench Round 4)", "file_type": "image", "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openlab_3d_docs_workbench_round4_bench_zoom_bench_zoom_view", "label": "OpenLab Bench Zoom View", "file_type": "concept", "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Close-up workbench camera mode of the 3D lab: the player has zoomed onto one bench, with HUD overlays for the experiment step, the selected equipment and the control hints, and an exit button to return to the room."}, {"id": "openlab_3d_docs_workbench_round4_bench_zoom_exit_bench_button", "label": "Exit Bench Button (\u0428\u0438\u0440\u044d\u044d\u043d\u044d\u044d\u0441 \u0433\u0430\u0440\u0430\u0445)", "file_type": "concept", "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openlab_3d_docs_workbench_round4_bench_zoom_experiment_step_card", "label": "Experiment Step Card", "file_type": "concept", "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-left card shows the experiment title, a teacher-mode badge, the current instruction ('Click the graduated cylinder and read its scale up close'), a collapsible Steps list (\u0410\u043b\u0445\u043c\u0443\u0443\u0434) and status text ('Preparation done. Start your first step.')."}, {"id": "openlab_3d_docs_workbench_round4_bench_zoom_nacl_from_carbonate_experiment", "label": "Obtaining Sodium Chloride from Carbonate (\u041a\u0430\u0440\u0431\u043e\u043d\