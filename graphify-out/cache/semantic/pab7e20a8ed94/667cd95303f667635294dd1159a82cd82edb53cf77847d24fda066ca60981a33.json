png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openlab_3d_docs_workbench_round4_bench_zoom_selection_highlight", "label": "Selection Highlight Box, Marker and Label", "file_type": "concept", "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The selected microscope has a wireframe bounding box, a yellow triangle marker above it and a floating label '\u041c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f \u00b7 \u0425\u043e\u043e\u0441\u043e\u043d' (Microscope \u00b7 Empty)."}, {"id": "openlab_3d_docs_workbench_round4_bench_zoom_evaporating_dish_on_stand", "label": "Evaporating Dish on Tripod Stand", "file_type": "concept", "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openlab_3d_docs_workbench_round4_bench_zoom_labeled_beaker", "label": "Labeled Beaker", "file_type": "concept", "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openlab_3d_docs_workbench_round4_bench_zoom_flask", "label": "Glass Flask", "file_type": "concept", "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openlab_3d_docs_workbench_round4_bench_zoom_graduated_cylinder", "label": "Graduated Cylinder (\u0425\u044d\u043c\u0436\u044d\u044d\u0441\u0442 \u0446\u0438\u043b\u0438\u043d\u0434\u0440)", "file_type": "concept", "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named in the current step instruction but not clearly visible on the zoomed bench; the empty grey shadow ellipse in the middle may be where it stands or should stand."}, {"id": "openlab_3d_docs_workbench_round4_bench_zoom_controls_hint_bar", "label": "Controls Hint Bar", "file_type": "concept", "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bottom bar lists the controls: Enter picks up, F inspects, clicking a tool measures, left-drag moves along the bench, right-drag rotates, and wheel or two-finger pinch zooms in and out. It covers both desktop and touch input."}, {"id": "openlab_3d_docs_workbench_round4_bench_zoom_side_drawer_toggle", "label": "Side Drawer Toggle Tab", "file_type": "concept", "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "openlab_3d_docs_workbench_round4_bench_zoom", "target": "openlab_3d_docs_workbench_round4_bench_zoom_bench_zoom_view", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "weight": 1.0}, {"source": "openlab_3d_docs_workbench_round4_bench_zoom_bench_zoom_view", "target": "openlab_3d_docs_workbench_round4_bench_zoom_exit_bench_button", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "weight": 1.0}, {"source": "openlab_3d_docs_workbench_round4_bench_zoom_bench_zoom_view", "target": "openlab_3d_docs_workbench_round4_bench_zoom_experiment_step_card", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openlab-3d/docs/workbench-round4/bench-zoom.png", "source_location": null, "weight": 1.0}, {"source": "ope