{
  "name": "openlab-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:chemquest": "tsc -b && vite build --base /openlab/ --outDir ../public/openlab --emptyOutDir",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test:workbench": "node --experimental-strip-types --test tests/molecules.test.mjs tests/mobile-interaction.test.mjs tests/quality-governor.test.mjs tests/still-batch.test.mjs tests/book-supplies.test.mjs tests/textbook-chemistry.test.mjs tests/textbook-makeable.test.mjs",
    "test:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/onest": "5.3.1",
    "@fontsource/poppins": "5.2.7",
    "@fontsource/unbounded": "5.3.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@react-three/postprocessing": "2.19.1",
    "@react-three/rapier": "1.5.0",
    "framer-motion": "11.18.2",
    "postprocessing": "6.37.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "troika-three-text": "0.52.5",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "5.4.14"
  }
}
